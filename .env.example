# =====================================================================
# AI Video Analyzer — 环境变量配置模板
# 使用方法：复制本文件为 .env，填入真实值后即可运行
#   cp .env.example .env
# ⚠️  .env 已加入 .gitignore，请勿将真实 Key 提交到代码库
# =====================================================================


# =====================================================================
# HuggingFace 配置（仅 VLM_BACKEND=huggingface 时需要）
# =====================================================================

# HuggingFace 访问 Token（下载私有/门控模型时需要）
# 获取地址：https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# HuggingFace 镜像加速（国内推荐，可加快模型下载）
# 默认官方源：https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# 禁用 XET 分块传输（解决部分网络环境超时，建议保持为 1）
HF_HUB_DISABLE_XET=1


# =====================================================================
# VLM（视觉语言模型）— 用于逐帧图像理解
# =====================================================================
# 可选值：huggingface | ollama | openai_compatible
VLM_BACKEND=huggingface

# --- 方案A：HuggingFace 本地（需安装 torch + transformers）---
# 模型推荐：Qwen/Qwen2-VL-2B-Instruct（轻量）或 Qwen/Qwen2-VL-7B-Instruct（效果更好）
VLM_HF_MODEL=Qwen/Qwen2-VL-2B-Instruct

# --- 方案B：Ollama 本地（需提前运行 ollama serve）---
VLM_OLLAMA_BASE_URL=http://localhost:11434
VLM_OLLAMA_MODEL=qwen2-vl:7b

# --- 方案C：OpenAI 兼容远程 API（GPT-4o / 本地 vLLM 等）---
VLM_API_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=sk-your_key_here
VLM_API_MODEL=gpt-4o


# =====================================================================
# LLM（纯文本大语言模型）— 用于增量总结 / ASR 文字总结
# =====================================================================
# 可选值：ollama | openai_compatible
# 注意：LLM 不支持 huggingface 模式
LLM_BACKEND=ollama

# --- 方案A：Ollama 本地（需提前运行 ollama serve）---
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=qwen2.5:7b

# --- 方案B：OpenAI 兼容远程 API（OpenAI / DeepSeek / Moonshot 等）---
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your_key_here
LLM_API_MODEL=gpt-4o-mini

